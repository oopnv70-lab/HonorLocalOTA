<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 深色模式：换父主题 + 关掉浅色状态栏，否则深色背景上状态栏图标看不见 -->
    <style name="ModuleTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>