<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      模块本体是 LSPosed 插件，界面盖在 com.hihonor.ouc 的进程里。
         · hook K / ActivityResult → 把「本地更新」入口投放到三点菜单
         · hook l5.b.p() → 检查更新恒为「无新版本」
      模块自身不需要任何 Activity，也不需要任何权限：
         · 不申请存储权限（面板读包用的是 SAF，见 PanelView）
         · 没有桌面图标，只在 LSPosed 模块列表里出现
    -->

    <application
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:hasCode="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        tools:ignore="AllowBackup" />

</manifest>