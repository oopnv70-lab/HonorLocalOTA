<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      这个模块不声明任何 Activity，也不声明任何权限。

      原因：界面是直接盖在 com.hihonor.ouc 的 MainEntranceActivity 上的一层 View，
      运行在 OUC 进程里（由 LSPosed 加载），不是独立组件。所以：
        · 没有桌面图标，没有可启动组件；
        · 不需要 exported、不需要跨进程 Intent；
        · 写 /data/local_ota 靠 OUC 自身的 platform_app 域权限，不需要 root；
        · 选文件走系统 SAF，不需要存储权限。

      装完之后只要在 LSPosed 里勾选并重启「软件更新」，三点菜单里就会出现原版的
      「本地更新」项（判定条件见 kh.l.C()），点它进我们的面板。
    -->

    <application
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:hasCode="true"
        android:allowBackup="false"
        tools:ignore="MissingApplicationIcon,AllowBackup" />

</manifest>