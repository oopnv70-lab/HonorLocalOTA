<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      模块本体是 LSPosed 插件，界面盖在 com.hihonor.ouc 的进程里。
      从 v2 起额外声明一个 SettingsActivity，提供桌面入口：
        · 用来编辑 version_spoof.conf（版本伪造配置）
        · 这个 Activity 跑在模块自己的进程里，和 OUC 里的 hook 互不影响
      需要 root：配置文件放在 OUC 自己的外部私有目录，
      该目录对其他 app 平台隔离，必须由 root 写入（本模块已在
      KernelSU 授权列表里，实测 su 可用）。
    -->

    <!--
      为什么需要 root：
        配置文件 /storage/emulated/0/Android/data/com.hihonor.ouc/files/
        /version_spoof.conf 在 OUC 自己的外部私有目录里。
        Android 11 起该目录对其他 app 平台强制隔离，实测本模块
        uid 10357 写入被 Permission denied，即使持有
        MANAGE_EXTERNAL_STORAGE 也进不去。
        本模块 io.github.honorlocalota 已在 KernelSU 授权列表
        （/data/adb/ksu/.allowlist 第一行），实测
        su 10357 -c '/system/bin/su -c id' → uid=0(root)，
        因此由 Activity 通过 su 写入、由 OUC 直接读取。
      所以这里不申请任何存储权限，不需要你手动授权。
    -->

    <application
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:hasCode="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        tools:ignore="AllowBackup">

        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:excludeFromRecents="false"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>